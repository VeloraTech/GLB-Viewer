@echo off
:: GLB Viewer installer
:: Generates register.reg with the correct absolute path to launcher-wrapper.bat
:: Then imports it into the Windows registry.
setlocal enabledelayedexpansion

:: Get the directory where this batch file lives (repo root)
set "REPO_DIR=%~dp0"
set "WRAPPER=%REPO_DIR%launcher-wrapper.bat"

if not exist "%WRAPPER%" (
    echo ERROR: launcher-wrapper.bat not found at %WRAPPER%
    pause
    exit /b 1
)

if not exist "%REPO_DIR%launcher.exe" (
    echo WARNING: launcher.exe not found at %REPO_DIR%launcher.exe
    echo Build it first: rustc launcher.rs -o launcher.exe
    echo.
)

:: Generate register.reg by replacing the placeholder with the real path
set "REG_FILE=%REPO_DIR%register.reg"
if not exist "%REG_FILE%" (
    echo ERROR: register.reg template not found
    pause
    exit /b 1
)

:: Escape backslashes for the .reg file (double them)
set "ESCAPED_PATH=%WRAPPER:\=\\%"

(
    echo Windows Registry Editor Version 5.00
    echo.
    echo ; GLB Viewer - Open With registration
    echo ; Generated by install.bat - do not edit directly
    echo.
    echo [HKEY_CLASSES_ROOT\GLBViewer\shell\open\command]
    echo @="\"%ESCAPED_PATH%\" \"%%1\""
    echo.
    echo [HKEY_CLASSES_ROOT\GLBViewer\shell\open\command\DropTarget]
    echo "CLSID"="{DC1C5A9C-E88A-4DDE-A5A1-60F82A20AEF7}"
    echo.
    echo [HKEY_CLASSES_ROOT\.glb]
    echo @="GLBViewer"
    echo.
    echo [HKEY_CLASSES_ROOT\.glb\OpenWithProgIds]
    echo "GLBViewer"=""
    echo.
    echo [HKEY_CLASSES_ROOT\.glb\ShellEx]
    echo [HKEY_CLASSES_ROOT\.glb\ShellEx\{BB2E617C-0920-11d1-9A0B-00C04FC2D6C1}]
    echo @="{DC1C5A9C-E88A-4DDE-A5A1-60F82A20AEF7}"
) > "%REG_FILE%"

echo Generated %REG_FILE% with path: %WRAPPER%
echo.

:: Import into registry
reg import "%REG_FILE%"
if errorlevel 1 (
    echo ERROR: Failed to import registry file. Run as Administrator.
    pause
    exit /b 1
)

echo.
echo GLB Viewer registered successfully.
echo Right-click any .glb file and choose Open With > GLB Viewer.
pause